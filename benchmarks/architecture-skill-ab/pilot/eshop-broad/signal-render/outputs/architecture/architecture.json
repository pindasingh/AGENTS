  "WebCheckoutAcceptance": {
    "kind": "flow",
    "name": "web checkout acceptance",
    "steps": [
      {
        "action": "request",
        "from": {
          "$ref": "BrowserCustomer"
        },
        "to": {
          "$ref": "WebCheckout"
        },
        "operation": "POST /checkout",
        "contract": {
          "$ref": "WebCheckout"
        }
      },
      {
        "action": "request",
        "from": {
          "$ref": "WebBff"
        },
        "to": {
          "$ref": "BasketCheckout"
        },
        "operation": "POST /api/v1/basket/checkout",
        "contract": {
          "$ref": "BasketCheckout"
        }
      },
      {
        "action": "read",
        "from": {
          "$ref": "BasketApi"
        },
        "to": {
          "$ref": "BasketRedis"
        },
        "operation": "GET customer basket",
        "evidence": [
          {
            "repository": "dotnet-architecture/eShopOnContainers",
