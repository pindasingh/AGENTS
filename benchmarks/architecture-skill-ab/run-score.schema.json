{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/architecture-skill-ab/run-score.schema.json",
  "title": "Architecture skill A/B run score",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "case_id", "candidate_slot", "replicate", "completed", "scores", "critical_errors", "metrics"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "candidate_slot": {"enum": ["A", "B"]},
    "replicate": {"type": "integer", "minimum": 1},
    "completed": {"type": "boolean"},
    "scores": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_accuracy", "projection_fidelity", "requested_view_compliance", "artifact_usefulness", "total"],
          "properties": {
            "semantic_accuracy": {"type": "number", "minimum": 0, "maximum": 45},
            "projection_fidelity": {"type": "number", "minimum": 0, "maximum": 20},
            "requested_view_compliance": {"type": "number", "minimum": 0, "maximum": 15},
            "artifact_usefulness": {"type": "number", "minimum": 0, "maximum": 20},
            "total": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      ]
    },
    "critical_errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "total_tokens", "tool_calls", "artifact_bytes", "validation_failures"],
      "properties": {
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "artifact_bytes": {"type": ["integer", "null"], "minimum": 0},
        "validation_failures": {"type": "integer", "minimum": 0}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
