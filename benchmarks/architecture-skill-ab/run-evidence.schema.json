{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/architecture-skill-ab/run-evidence.schema.json",
  "title": "Architecture skill A/B completed-run evidence records",
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "candidate_slot", "model", "system_instructions_sha256", "tool_policy_sha256", "completed", "budget_exhausted", "errors"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "candidate_slot": {"enum": ["A", "B"]},
        "model": {"type": "string", "minLength": 1},
        "system_instructions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "completed": {"const": true},
        "budget_exhausted": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_tokens", "duration_ms", "tool_calls", "captured_from_callback"],
      "properties": {
        "total_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "captured_from_callback": {"const": true}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_viewer", "authoritative_sources_validated", "commands", "viewer"],
      "properties": {
        "native_viewer": {"type": "string", "minLength": 1},
        "authoritative_sources_validated": {"const": true},
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "log_path", "log_sha256"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "exit_code": {"const": 0},
              "log_path": {"type": "string", "minLength": 1},
              "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "viewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "exit_code", "log_path", "log_sha256", "artifact_paths", "checks"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "exit_code": {"const": 0},
            "log_path": {"type": "string", "minLength": 1},
            "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "artifact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
